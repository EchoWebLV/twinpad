# Copy to .env. Values equal to "<fill>" count as unset. Extra files can be loaded first via ENV_FILE=a:b.

# ---- RPC ----
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com      # falls back to RPC_URL
EVM_RPC_URL=https://robinhood-rpc.publicnode.com,https://rpc.mainnet.chain.robinhood.com,https://rpc.ordofi.network   # Robinhood Chain (4663); comma-separated = tried in order, next on any error. The official RPC Cloudflare-403s some hosts; rpc.ordofi.network lags ~700 blocks on one replica.

# ---- Pool wallets: the operator's capital. Fronts every launch, receives deposits. Never lent below the floors. ----
POOL_SOL_KEY=                                           # base58 secret key
POOL_EVM_KEY=                                           # 0x-prefixed private key
POOL_MIN_SOL=5
POOL_MIN_ETH=0.05

# ---- Launch economics (TWINE V2 defaults; see README for the small-amount test profile) ----
DEPOSIT_SOL=0.5                                         # deployer deposit (refund on success is phase 2)
DEPOSIT_DEADLINE_MIN=60                                 # unpaid launches expire after this
FRONT_SOL=13.8                                          # ceiling: pool → per-coin creator/maker wallet (dev buy = front - SOL_GAS_BUDGET + boost)
FRONT_ETH=0.33                                          # ceiling: pool → per-coin Pons maker wallet
AUTO_SIZE=true                                          # front = what the pool has free above the floor / open slots, between FRONT_*_MIN and FRONT_*;
FRONT_SOL_MIN=0.6                                       # SOL is also capped at the parity dev buy (pump.fun landing on the Pons floor)
FRONT_ETH_MIN=0.03
MAX_BOOST_SOL=20                                        # deployers may add this much SOL to the dev buy on top of the deposit (0 = off); refunded pro-rata at close
# Out of SOL_GAS_BUDGET: what the pump.fun creator wallet gets (create rent + bundle tip); the rest is maker gas.
SOL_CREATOR_SOL=0.04
# Jito tip for the atomic create + opening-buy bundle; JITO_BLOCK_ENGINE overrides the endpoint.
JITO_TIP_SOL=0.001
SOL_GAS_BUDGET=0.13                                     # kept back from FRONT_SOL for fees + maker cash
EVM_GAS_LAUNCHER=0.012                                  # pool → per-coin launcher wallet, on top of the 0.0005 ETH launch fee
EVM_MAKER_CASH=0.01                                     # kept back from FRONT_ETH as maker cash
SEED_PONS=true                                          # the Pons opening buy spends the whole ETH front above the maker cash, not just what parity needs
EVM_CREATOR_TAX_BPS=200                                 # Pons creator tax (max 1000); paid to the per-coin maker wallet
SOL_SLIPPAGE_PCT=10
SOL_PRIORITY_FEE_SOL=0.0005

# ---- Approval / limits ----
AUTO_APPROVE=false                                      # true = paid launches go straight to the queue
LAUNCHES_CLOSED=false                                   # true = refuse every new launch and hold the queue (the operator's off switch)
ADMIN_TOKEN=                                            # required for /api/admin/* and the /admin page
BANNED_WALLETS=                                         # comma-separated deployer/payer wallets refused at POST /api/paid (admin bans persist in DATA_DIR/bans.json)
BANNED_NAMES=                                           # comma-separated substrings reserved in token names/symbols, e.g. twinpad,twin
MAX_LIVE_MAKERS=10
MAX_OPEN_LAUNCHES=20
LAUNCH_AUTO_RETRIES=2                                   # failed launches re-queued this many times (from the checkpoint, nothing re-spent)
LAUNCH_RETRY_BACKOFF_MIN=5

# ---- exit policy: at launch + RETIRE_AFTER_MIN the coin needs RETIRE_MIN_BUYERS outside holders
# or RETIRE_MIN_USD held by outsiders (both chains), else the pool exits: instant close at zero
# holders, otherwise selldown (sell clips at/above entry, no buys) for RETIRE_SELLDOWN_MIN then close.
RETIRE_ENABLED=true
RETIRE_AFTER_MIN=10
RETIRE_MIN_BUYERS=5
RETIRE_MIN_USD=100
RETIRE_SELLDOWN_MIN=45

# ---- front recovery: in the band, while a side's front is not repaid and it trades at entry × (1 + margin),
# the maker sells a clip into the demand; quote above MAKER_MIN_* + RECOVER_KEEP_CLIPS clips goes back to the
# pool. When Pons demand drains the maker's ETH the pool tops it up. repaid ≥ fronted on both chains = "front retired".
RECOVER_ENABLED=true
RECOVER_MARGIN=0.10
RECOVER_KEEP_CLIPS=4
TOPUP_ETH=0.02
MAX_TOPUP_ETH_PER_COIN=0.2
TOPUP_SOL=0.5
MAX_TOPUP_SOL_PER_COIN=3
# Creator fees are claimed while live (once a minute per coin) when at least this much is waiting: the pump.fun
# creator vault (SOL, to the creator wallet) and the Pons creator-tax escrow (ETH, to the maker wallet).
CLAIM_MIN_SOL=0.01
CLAIM_MIN_ETH=0.002

# ---- loss guards (USD, fronted value minus what the maker still holds minus what came back)
MAX_LOSS_USD_PER_COIN=150                               # halts that coin's maker
MAX_LOSS_USD_POOL=500                                   # halts every maker and pauses approvals (POST /api/admin/pool/resume)
ALERT_WEBHOOK_URL=                                      # optional: JSON POST {text} on halts, breaker, closes

# ---- IPFS ----
PINATA_JWT=                                             # Pinata v3 JWT; image + metadata are pinned at form submit

# ---- Maker (per live coin) ----
BAND=0.05
MAKER_ENABLED=true
MAKER_INTERVAL_MS=1000                                  # a tick that traded re-ticks at once on fresh prices
POLL_INTERVAL_MS=1000                                   # both curves + fx for every live coin
MAKER_MAX_CLIP_USD=300
MAKER_MIN_SOL=0.3
MAKER_MIN_ETH=0.01
MAKER_MAX_ERRORS=5
MAKER_MAX_BOUGHT_CLIPS=12                               # per side, tokens the peg bought on top of the opening position may not exceed this many clips at cost; sells release it, no top-up past it

# ---- Server ----
PORT=8787
CORS_ORIGIN=*
PUBLIC_URL=                                             # web app URL; token website = <PUBLIC_URL>/coin/<id>
DATA_DIR=./data                                         # launches/<id>/{record.json,keys.json,image.png}, state/<id>.json
