# Copy to .env (gitignored). One of the two signer options is required.
# Option A: sign locally (trade-local). Path is relative to this folder.
SOLANA_KEYPAIR_PATH=../.keys/solana-deployer.json
# SOLANA_PRIVATE_KEY=            # base58 or [1,2,...] array; overrides the path
# Option B: PumpPortal Lightning only (no local signer)
# PUMPPORTAL_API_KEY=
RPC_URL=https://api.mainnet-beta.solana.com
MINT_KEYPAIR_PATH=../.keys/pumpfun-mint.json
DEV_BUY_SOL=0.05
SLIPPAGE=10
PRIORITY_FEE=0.0005
